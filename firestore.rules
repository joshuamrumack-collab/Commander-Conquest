rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoom(data) {
      return data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 100 &&
             data.hostId is string && data.hostId.size() <= 128 &&
             data.status in ['waiting', 'in_game', 'finished'] &&
             data.mapSize in ['small', 'medium', 'large'] &&
             data.slots is list && data.slots.size() <= 4;
    }

    // Rooms collection
    match /rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if true;
      allow create: if isValidId(roomId) && isValidRoom(request.resource.data);
      allow update: if isValidId(roomId) && isValidRoom(request.resource.data);
      allow delete: if isValidId(roomId);
    }

    // Test connection doc
    match /test/connection {
      allow read: if true;
    }
  }
}
